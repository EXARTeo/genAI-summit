# Copy this file to .env and fill in the values. Never commit .env.
# Repo-level settings only. The product stack's variables (ports, databases,
# Langfuse) are in product/.env.example -> product/.env.

# Runtime environment: development | production
APP_ENV=development
LOG_LEVEL=INFO

# LLM provider keys (fill in the ones the project uses)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
