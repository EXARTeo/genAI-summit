# Frontend (Vite). Copy to product/frontend/.env for `npm run dev`.
# In Docker these come from product/.env as build args (see product/.env.example).

# true = no backend needed: every /api call is answered by in-browser fixtures
# (src/shared/lib/mocks). `npm run dev:mocks` turns it on too.
VITE_USE_MOCKS=false
# Dev server only: where /api is proxied to (the backend's published port).
VITE_DEV_BACKEND_URL=http://127.0.0.1:8100
# "Open in Langfuse" links on audit steps (the published Langfuse UI, product/.env LANGFUSE_PORT).
VITE_LANGFUSE_URL=http://localhost:3400
VITE_LANGFUSE_PROJECT_ID=product
